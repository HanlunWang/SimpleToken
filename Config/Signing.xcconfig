// Code signing. The default is ad-hoc signing ("-"), which is enough to build and run locally.
// To sign with your own Apple Development certificate, create Config/Signing.local.xcconfig
// (git-ignored) with, for example:
//
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = ABCDE12345
//
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
